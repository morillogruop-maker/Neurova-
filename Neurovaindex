"use client";

import { useState, useRef } from "react";
import Script from "next/script";
import { Stat } from "@/components/Stat";

declare global {
  interface Window { turnstile: any }
}

export default function Page() {
  const [state, setState] = useState<"idle" | "ok" | "err">("idle");
  const [via, setVia] = useState<string>("");
  const widgetRef = useRef<any>(null);

  async function getTurnstileToken(): Promise<string> {
    const siteKey = process.env.NEXT_PUBLIC_TURNSTILE_SITE_KEY;
    if (typeof window === "undefined" || !window.turnstile || !siteKey) return "";
    const container = document.getElementById("cf-turnstile");
    const tf = window.turnstile;
    if (container) {
      if (!widgetRef.current) {
        widgetRef.current = tf.render(container, { sitekey: siteKey, size: "invisible" });
      }
      try {
        const t = await tf.execute(widgetRef.current);
        return t || "";
      } catch {
        return "";
      }
    }
    return "";
  }

  async function onSubmit(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    const form = e.currentTarget;
    const formData = new FormData(form);
    const payload: any = {
      name: String(formData.get("name") || ""),
      email: String(formData.get("email") || ""),
      message: String(formData.get("message") || ""),
      website: String(formData.get("website") || ""), // honeypot
    };
    const t = await getTurnstileToken();
    if (t) payload.token = t;

    try {
      const res = await fetch("/api/leads", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const json = await res.json();
      if (json.ok) {
        setVia("postgres");
        setState("ok");
        form.reset();
      } else {
        setState("err");
      }
    } catch {
      setState("err");
    }
  }

  return (
    <>
      <Script src="https://challenges.cloudflare.com/turnstile/v0/api.js" strategy="lazyOnload" />
      <div className="min-h-screen bg-neutral-950 text-white selection:bg-fuchsia-600/30">
        <header className="sticky top-0 z-30 backdrop-blur supports-[backdrop-filter]:bg-neutral-950/60 border-b border-white/10">
          <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <a href="#" className="flex items-center gap-3">
              <div className="h-8 w-8 rounded-xl bg-gradient-to-tr from-fuchsia-500 to-indigo-500 grid place-items-center font-black">
                <span className="text-xs">NG</span>
              </div>
              <span className="text-lg font-semibold tracking-tight">Neurova Group</span>
            </a>
            <nav className="hidden md:flex items-center gap-8 text-sm text-neutral-300">
              <a href="#servicios" className="hover:text-white">Servicios</a>
              <a href="#casos" className="hover:text-white">Casos</a>
              <a href="#stack" className="hover:text-white">Stack</a>
              <a href="#contacto" className="hover:text-white">Contacto</a>
            </nav>
            <a href="#contacto" className="inline-flex items-center rounded-xl bg-white/10 hover:bg-white/20 px-4 py-2 text-sm">Agenda una demo</a>
          </div>
        </header>

        <section className="relative overflow-hidden">
          <div className="pointer-events-none absolute inset-0 bg-[radial-gradient(60rem_60rem_at_70%_-10%,rgba(168,85,247,0.15),transparent_60%),radial-gradient(40rem_40rem_at_10%_-10%,rgba(99,102,241,0.12),transparent_60%)]" />
          <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 pb-16">
            <div className="grid lg:grid-cols-12 gap-10 items-center">
              <div className="lg:col-span-7">
                <h1 className="text-4xl sm:text-5xl font-extrabold leading-tight tracking-tight">
                  Infraestructura cognitiva para <span className="text-transparent bg-clip-text bg-gradient-to-r from-fuchsia-400 to-indigo-400">negocios reales</span>
                </h1>
                <p className="mt-5 text-neutral-300 max-w-2xl">
                  Orquestamos datos, IA y automatización en una sola plataforma. Método HOC: menos fricción, más margen, entrega continua.
                </p>
                <div className="mt-8 flex flex-wrap gap-3">
                  <a href="#servicios" className="rounded-xl bg-gradient-to-r from-fuchsia-500 to-indigo-500 px-5 py-3 text-sm font-medium">Ver oferta</a>
                  <a href="#contacto" className="rounded-xl border border-white/15 px-5 py-3 text-sm font-medium hover:bg-white/5">Cotizar ahora</a>
                </div>
                <div className="mt-8 flex items-center gap-6 text-xs text-neutral-400">
                  <div>Deploy en 7–21 días*</div>
                  <div>SLAs de 99.9%</div>
                  <div>Seguridad Zero-Trust</div>
                </div>
              </div>
              <div className="lg:col-span-5">
                <div className="rounded-2xl border border-white/10 bg-white/5 p-4">
                  <div className="rounded-xl bg-neutral-900 border border-white/10 p-5">
                    <div className="text-sm text-neutral-300">Panel Neurova</div>
                    <div className="mt-3 grid grid-cols-2 gap-3 text-xs">
                      <Stat label="Pipelines" value="128" />
                      <Stat label="Tareas/día" value="64k" />
                      <Stat label="Ahorro Opex" value="28%" />
                      <Stat label="Latencia p95" value="120ms" />
                    </div>
                    <div className="mt-4 text-[10px] text-neutral-500">*Estimación de referencia según alcance.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="servicios" className="py-20 border-t border-white/10">
          <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <h2 className="text-2xl font-bold">Servicios modulares</h2>
            <p className="mt-2 text-neutral-400">Selecciona bloques. Escala según demanda.</p>
            <div className="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {[
                { title: 'IA aplicada', desc: 'Copilotos, RAG, agentes y visión para operaciones.' },
                { title: 'Datos', desc: 'Lagos de datos, ETL/ELT, gobernanza y MDM.' },
                { title: 'Apps + Automatización', desc: 'Frontends, APIs, bots, BPM y tareas sin código.' },
                { title: 'Seguridad', desc: 'Zero-Trust, SSO, DLP, auditoría y cumplimiento.' },
              ].map((c) => (
                <div key={c.title} className="rounded-2xl border border-white/10 bg-white/5 p-5">
                  <div className="text-lg font-semibold">{c.title}</div>
                  <div className="mt-2 text-sm text-neutral-300">{c.desc}</div>
                  <a href="#contacto" className="mt-4 inline-block text-sm text-fuchsia-300 hover:text-fuchsia-200">Solicitar propuesta →</a>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section id="casos" className="py-20 border-t border-white/10">
          <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <h2 className="text-2xl font-bold">Casos de uso</h2>
            <div className="mt-10 grid gap-6 md:grid-cols-2">
              {[
                { title: 'Retail inteligente', points: ['Forecast de demanda', 'Recomendadores', 'Optimización de inventario'] },
                { title: 'Salud digital', points: ['Triage con IA', 'Resumen clínico', 'Alertas tempranas'] },
                { title: 'Finanzas', points: ['Detección de fraude', 'scoring crediticio', 'Automatización KYC'] },
                { title: 'Manufactura', points: ['Mantenimiento predictivo', 'Visión industrial', 'Gemelos digitales'] },
              ].map((c) => (
                <div key={c.title} className="rounded-2xl border border-white/10 bg-white/5 p-6">
                  <div className="text-lg font-semibold">{c.title}</div>
                  <ul className="mt-3 space-y-2 text-sm text-neutral-300 list-disc list-inside">
                    {c.points.map((p) => (<li key={p}>{p}</li>))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section id="stack" className="py-20 border-t border-white/10">
          <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <h2 className="text-2xl font-bold">Stack de referencia</h2>
            <p className="mt-2 text-neutral-400">Composable. Multi-nube. API-first.</p>
            <div className="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 text-sm">
              {[
                { k: 'Datos', v: 'Postgres, BigQuery/Lake, dbt, Airbyte, Airflow, Kafka' },
                { k: 'IA', v: 'OpenAI, Vertex, local LLMs, Vector DB, RAG, agentes' },
                { k: 'Front', v: 'Next.js, React Native/Expo, Tailwind, Expo Router' },
                { k: 'Back', v: 'Node/TS, FastAPI, gRPC, GraphQL, tRPC' },
                { k: 'DevOps', v: 'Docker, Terraform, GitHub Actions, Sentry, Vercel/Fly/Render' },
                { k: 'Seguridad', v: 'OIDC/SSO, Keycloak, Vault, audit logs, Zero-Trust' },
              ].map((row) => (
                <div key={row.k} className="rounded-xl border border-white/10 bg-white/5 p-4 flex items-start justify-between">
                  <div>
                    <div className="text-neutral-400">{row.k}</div>
                    <div className="mt-1 font-medium">{row.v}</div>
                  </div>
                  <span className="text-[10px] text-neutral-500">ref</span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section id="contacto" className="py-20 border-t border-white/10">
          <div className="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
            <h2 className="text-2xl font-bold">¿Listo para acelerar?</h2>
            <p className="mt-2 text-neutral-300">Cuéntanos el caso y enviamos una propuesta técnica en 48 horas.</p>
            <form className="mt-8 grid gap-3 text-left" onSubmit={onSubmit}>
              <div id="cf-turnstile" className="hidden" aria-hidden="true"></div>
              <input name="website" type="text" className="hidden" tabIndex={-1} autoComplete="off" aria-hidden="true" />

              <input name="name" type="text" placeholder="Nombre" className="w-full rounded-xl bg-white/5 border border-white/10 px-4 py-3" />
              <input name="email" type="email" placeholder="Email" className="w-full rounded-xl bg-white/5 border border-white/10 px-4 py-3" required />
              <textarea name="message" placeholder="Necesidad (máx. 300 caracteres)" maxLength={300} className="w-full rounded-xl bg-white/5 border border-white/10 px-4 py-3 h-28" />
              <button type="submit" className="rounded-xl bg-gradient-to-r from-fuchsia-500 to-indigo-500 px-5 py-3 text-sm font-medium">Enviar</button>
              {state === "ok" && <div className="text-xs text-emerald-400">Recibido (postgres).</div>}
              {state === "err" && <div className="text-xs text-red-400">Error al enviar.</div>}
              <div className="text-xs text-neutral-500">Al enviar aceptas la política de privacidad.</div>
            </form>
          </div>
        </section>

        <footer className="border-t border-white/10 py-10">
          <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid gap-6 md:grid-cols-2 items-center">
            <div className="text-sm text-neutral-400">© {new Date().getFullYear()} Neurova Group. Todos los derechos reservados.</div>
            <div className="md:justify-self-end text-sm flex gap-6 text-neutral-300">
              <a href="#" className="hover:text-white">Privacidad</a>
              <a href="#" className="hover:text-white">Términos</a>
              <a href="#contacto" className="hover:text-white">Contacto</a>
            </div>
          </div>
        </footer>
      </div>
    </>
  );
